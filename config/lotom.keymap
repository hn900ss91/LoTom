#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/* ========================================================
   低DPI（精密操作）プロセッサー定義
   ======================================================== */
/ {
    zip_slow_scaler: zip_slow_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        mul = <1>;
        div = <5>;
    };
};

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <1>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <400>;
};

/ {
    behaviors {
      scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
          compatible = "zmk,behavior-runtime-sensor-rotate";
          label = "ENCODER_MSC_DOWN_UP";
          #sensor-binding-cells = <0>;
          cw-binding = <&msc SCRL_DOWN>;
          ccw-binding = <&msc SCRL_UP>;
      };

      bottom_rotate: behavior_sensor_rotate_bottom {
          compatible = "zmk,behavior-runtime-sensor-rotate";
          label = "ENCODER_BOTTOM";
          #sensor-binding-cells = <0>;
          cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
          ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
      };

      /* クリック後200ms間マウスレイヤーを保持する設定 */
      sl_mouse: sticky_layer_for_mouse {
          compatible = "zmk,behavior-sticky-key";
          #binding-cells = <1>;
          bindings = <&mo>;
          release-after-ms = <200>;
          quick-release;
          ignore-modifiers;
      };
    };

    macros {
      /* 左クリック時にオートマウスレイヤーを脱出するマクロ */
      click_and_exit: click_and_exit {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <0>;
          tap-ms = <0>;
          bindings
              = <&macro_press &mkp LCLK>
              , <&macro_pause_for_release>
              , <&macro_release &mkp LCLK>
              , <&macro_tap &to 0>
              , <&macro_tap &sl_mouse 1>;
      };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        // Layer 0 (デフォルトレイヤー)
        default_layer {
            bindings = <
&lt 6 ESC                                                                                                                                                 &kp ESC
&kp Q       &kp W         &kp E             &kp R           &kp T            &kp TAB            &kp JP_YEN  &kp Y            &kp U     &kp I      &kp O        &kp P
&kp A       &kp S         &kp D             &kp F           &kp G            &kp LS(N8)         &kp LS(N9)  &kp H            &kp J     &kp K      &kp L        &kp MINUS
&kp Z       &kp X         &kp C             &kp V           &kp B            &kp JP_EISU        &kp LBKT    &kp N            &kp M     &kp COMMA  &kp DOT      &lt 2 SLASH
&kp LSHIFT  &kp LCTRL     &kp LCMD          &kp LALT        &lt 4 JP_SPACE   &lt 3 JP_KANA      &lt 2 BSPC  &lt 3 ENTER                           &lt 2 ESC    &lt 1 JP_ZNK
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 1 (MOUSE レイヤー)
        MOUSE {
            bindings = <
&trans                                                                                                                                                                &trans
&trans      &trans        &trans            &trans          &trans           &trans             &trans      &trans           &trans           &mkp MB4   &mkp MB5     &trans
&trans      &trans        &trans            &trans          &trans           &trans             &trans      &mo 5            &click_and_exit  &mkp MB3   &mkp MB2     &trans
&trans      &trans        &trans            &trans          &trans           &trans             &trans      &trans           &trans           &trans     &trans       &trans
&kp LALT    &kp LCTRL     &kp LCMD          &kp LSHIFT      &trans           &trans             &trans      &mo 3                                              &trans       &trans
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 2 (SCROLL レイヤー)
        SCROLL {
            bindings = <
&trans                                                                                        &trans
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans      &trans  &trans                  &trans  &trans
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 3 (ARROW レイヤー)
        ARROW {
            bindings = <
&trans                                                                                                                                                                                               &trans
&kp GRAVE  &kp LC(LS(TAB))         &kp LG(RIGHT)   &kp NUMBER_9             &kp NUMBER_0       &trans      &trans  &trans  &kp RC(LEFT_ARROW)  &kp UP_ARROW      &kp RC(RIGHT_ARROW)  &kp LG(P)
&kp TAB    &kp LA(LG(LEFT_ARROW))  &kp LG(LEFT)    &kp LG(LA(RIGHT_ARROW))  &kp LEFT_BRACKET   &trans      &trans  &trans  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp LG(K)
&kp LCMD   &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &kp RIGHT_BRACKET  &trans      &trans  &trans  &trans              &kp LC(UP_ARROW)  &trans               &kp LG(L)
&trans     &trans                  &trans          &trans                   &trans             &trans      &trans  &trans                                        &trans               &trans
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 4 (NUM レイヤー)
        NUM {
            bindings = <
&trans                                                                                                                                                                                     &trans
&kp GRAVE                &kp NUMBER_7  &kp NUMBER_8  &kp LG(LS(NUMBER_4))  &kp PLUS      &trans      &trans  &kp BACKSLASH    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SEMICOLON
&kp SLASH                &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6          &kp ASTERISK  &trans      &trans  &kp EXCLAMATION  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SQT
&mt LEFT_SHIFT NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3          &kp PERIOD    &trans      &trans  &kp NUMBER_0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans                   &trans        &trans        &trans                &trans        &trans      &trans  &kp LEFT_SHIFT                               &trans        &trans
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 5 (SLOW_DPI 精密操作レイヤー)
        SLOW_DPI {
            bindings = <
&trans                                                                                   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                  &trans   &trans
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 6 (BT レイヤー)
        BT {
            bindings = <
&trans                                                                                                                                                           &bt BT_CLR
&kp LG(Q)         &kp LC(W)  &trans     &trans     &trans  &trans      &trans  &bt BT_PRV  &bt BT_NXT  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LS(LG(Z))     &trans     &kp LC(C)  &trans     &trans  &trans      &trans  &trans      &trans      &trans        &trans        &trans
&kp LG(Z)         &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans  &trans      &trans  &trans      &trans      &trans        &trans        &trans
&studio_unlock    &trans     &trans     &trans     &trans  &trans      &trans  &trans                                &trans        &trans
            >;

            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };
    };
};
