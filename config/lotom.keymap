#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/* ========================================================
   オートマウスレイヤー＆トラックボールリスナー設定
   ======================================================== */
&zip_temp_layer {
    /delete-property/ excluded-positions;
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&vtrackball>;
        input-processors = <&zip_temp_layer 1 400>;
    };
};

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <1>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <400>;
};

/ {
    behaviors {
      scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
          compatible = "zmk,behavior-runtime-sensor-rotate";
          label = "ENCODER_MSC_DOWN_UP";
          #sensor-binding-cells = <0>;
          cw-binding = <&msc SCRL_DOWN>;
          ccw-binding = <&msc SCRL_UP>;
      };

      bottom_rotate: behavior_sensor_rotate_bottom {
          compatible = "zmk,behavior-runtime-sensor-rotate";
          label = "ENCODER_BOTTOM";
          #sensor-binding-cells = <0>;
          cw-binding = <&kp LA(LG(RIGHT))>;
          ccw-binding = <&kp LA(LG(LEFT))>;
      };

      /* クリック後200ms間マウスレイヤーを保持する設定 */
      sl_mouse: sticky_layer_for_mouse {
          compatible = "zmk,behavior-sticky-key";
          #binding-cells = <1>;
          bindings = <&mo>;
          release-after-ms = <200>;
          quick-release;
          ignore-modifiers;
      };
    };

    macros {
      /* 左クリック時にオートマウスレイヤーを脱出するマクロ */
      click_and_exit: click_and_exit {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <0>;
          tap-ms = <0>;
          bindings
              = <&macro_press &mkp LCLK>
              , <&macro_pause_for_release>
              , <&macro_release &mkp LCLK>
              , <&macro_tap &to 0>
              , <&macro_tap &sl_mouse 1>;
      };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        // Layer 0 (デフォルトレイヤー)
        default_layer {
            bindings = <
&lt 6 ESC                                                                                                                                             &kp ESC
&kp Q       &kp W         &kp E             &kp R           &kp T            &kp TAB            &kp INT3    &kp Y            &kp U     &kp I      &kp O        &kp P
&kp A       &kp S         &kp D             &kp F           &kp G            &kp LS(N8)         &kp LS(N9)  &kp H            &kp J     &kp K      &kp L        &kp MINUS
&kp Z       &kp X         &kp C             &kp V           &kp B            &kp LANG2          &kp LBKT    &kp N            &kp M     &kp COMMA  &kp DOT      &lt 2 SLASH
&kp LSHIFT  &kp LCTRL     &kp LCMD          &kp LALT        &lt 4 SPACE      &lt 3 LANG1        &lt 2 BSPC  &lt 3 ENTER                           &lt 2 ESC    &lt 1 INT5
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 1 (MOUSE レイヤー)
        MOUSE {
            bindings = <
&trans                                                                                                                                                                &trans
&trans      &trans        &trans            &trans          &trans           &trans             &trans      &trans           &trans           &mkp MB4   &mkp MB5     &trans
&trans      &trans        &trans            &trans          &trans           &trans             &trans      &mo 5            &click_and_exit  &mkp MB3   &mkp MB2     &trans
&trans      &trans        &trans            &trans          &trans           &trans             &trans      &trans           &trans           &trans     &trans       &trans
&kp LALT    &kp LCTRL     &kp LCMD          &kp LSHIFT      &trans           &trans             &trans      &mo 3                                              &trans       &trans
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 2 (SCROLL レイヤー)
        SCROLL {
            bindings = <
&trans                                                                                        &trans
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans      &trans  &trans                  &trans  &trans
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 3 (ARROW レイヤー)
        ARROW {
            bindings = <
&trans                                                                                                                                                                                               &trans
&kp GRAVE  &kp LC(LS(TAB))         &kp LG(RIGHT)   &kp N9                   &kp N0             &trans      &trans  &trans  &kp RC(LEFT)        &kp UP            &kp RC(RIGHT)        &kp LG(P)
&kp TAB    &kp LA(LG(LEFT))        &kp LG(LEFT)    &kp LG(LA(RIGHT))        &kp LBKT           &trans      &trans  &trans  &kp LEFT            &kp DOWN          &kp RIGHT            &kp LG(K)
&kp LCMD   &kp LG(LS(LEFT))        &trans          &kp LG(LS(RIGHT))        &kp RBKT           &trans      &trans  &trans  &trans              &kp LC(UP)        &trans               &kp LG(L)
&trans     &trans                  &trans          &trans                   &trans             &trans      &trans  &trans                                        &trans               &trans
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 4 (NUM レイヤー)
        NUM {
            bindings = <
&trans                                                                                                                                                                                     &trans
&kp GRAVE                &kp N7        &kp N8        &kp LG(LS(N4))        &kp PLUS      &trans      &trans  &kp BACKSLASH    &kp N7        &kp N8        &kp N9        &kp SEMICOLON
&kp SLASH                &kp N4        &kp N5        &kp N6                &kp ASTERISK  &trans      &trans  &kp EXCLAMATION  &kp N4        &kp N5        &kp N6        &kp SQT
&mt LSHIFT N0            &kp N1        &kp N2        &kp N3                &kp PERIOD    &trans      &trans  &kp N0           &kp N1        &kp N2        &kp N3        &kp EQUAL
&trans                   &trans        &trans        &trans                &trans        &trans      &trans  &kp LSHIFT                                     &trans        &trans
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 5 (SLOW_DPI 精密操作レイヤー)
        SLOW_DPI {
            bindings = <
&trans                                                                                   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                  &trans   &trans
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };

        // Layer 6 (BT レイヤー)
        BT {
            bindings = <
&trans                                                                                                                                                           &bt BT_CLR
&kp LG(Q)         &kp LC(W)  &trans     &trans     &trans  &trans      &trans  &bt BT_PRV  &bt BT_NXT  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LS(LG(Z))     &trans     &kp LC(C)  &trans     &trans  &trans      &trans  &trans      &trans      &trans        &trans        &trans
&kp LG(Z)         &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans  &trans      &trans  &trans      &trans      &trans        &trans        &trans
&studio_unlock    &trans     &trans     &trans     &trans  &trans      &trans  &trans                                &trans        &trans
            >;
            sensor-bindings = <
                &bottom_rotate
                &scroll_up_down
            >;
        };
    };
};
